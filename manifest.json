{
  "manifest_version": 3,
  "name": "MakeVideo → Google Flow",
  "version": "0.1.0",
  "description": "Lấy cảnh (ảnh + prompt) từ MakeVideo, tự tạo video trên Google Flow rồi gửi video về lại MakeVideo.",
  "permissions": ["storage", "sidePanel", "tabs", "downloads"],
  "host_permissions": [
    "http://127.0.0.1:5100/*",
    "http://localhost:5100/*",
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "https://*.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "MakeVideo → Google Flow" },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
